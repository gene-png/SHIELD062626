{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/setup.sh", "timeout": 120 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/no-bulk-stage.sh", "timeout": 15 },
          { "type": "command", "command": "bash .claude/hooks/identity.sh", "timeout": 30 },
          { "type": "command", "command": "bash .claude/hooks/gate.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
